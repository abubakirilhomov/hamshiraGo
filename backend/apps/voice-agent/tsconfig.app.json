{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": "../../",
    "outDir": "../../dist/apps/voice-agent",
    "declaration": false,
    "paths": {
      "@/*": ["apps/api/src/*"],
      "@app/common": ["libs/common/src"],
      "@app/common/*": ["libs/common/src/*"],
      "@app/database": ["libs/database/src"],
      "@app/database/*": ["libs/database/src/*"],
      "@app/contracts": ["libs/contracts/src"],
      "@app/contracts/*": ["libs/contracts/src/*"]
    }
  },
  "include": ["src/**/*", "../../libs/**/*", "../../apps/api/src/**/*"],
  "exclude": ["node_modules", "dist", "test"]
}
