{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/apps/api",
    "declaration": false,
    "paths": {
      "@/*": ["./src/*"],
      "@app/common": ["../../libs/common/src"],
      "@app/common/*": ["../../libs/common/src/*"],
      "@app/database": ["../../libs/database/src"],
      "@app/database/*": ["../../libs/database/src/*"],
      "@app/contracts": ["../../libs/contracts/src"],
      "@app/contracts/*": ["../../libs/contracts/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "test"]
}
